/* pages/lostfound/detail/index.wxss */
/* 招领详情页样式 */

/* 滚动容器 */
/* Skyline 不支持 vh：page 纵向 flex，滚动区 flex:1 自适应导航栏真实高度 */
page {
  display: flex;
  flex-direction: column;
}

.lfd-scroll {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: var(--space-md);
}

/* 信息卡片 */
.lfd-card {
  margin-bottom: var(--space-md);
  display: flex;
  flex-direction: column;
}

/* 头部：物品名 + 类型 */
.lfd-card__header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.lfd-card__name {
  flex: 1;
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-text-primary);
  margin-right: var(--space-sm);
}

.lfd-card__kind {
  flex-shrink: 0;
  padding: 4rpx var(--space-sm);
  font-size: var(--font-xs);
  border-radius: var(--radius-full);
  line-height: 1.4;
}

/* 元信息行 */
.lfd-card__meta {
  margin-top: var(--space-sm);
  display: flex;
  flex-direction: row;
  align-items: center;
}

.lfd-card__meta-label {
  width: 100rpx;
  font-size: var(--font-sm);
  color: var(--color-text-placeholder);
  flex-shrink: 0;
}

.lfd-card__meta-value {
  flex: 1;
  font-size: var(--font-md);
  color: var(--color-text-primary);
}

/* 地图预览容器 */
.lfd-map-wrap {
  margin-top: var(--space-sm);
  border-radius: var(--radius-md);
  overflow: hidden;
  position: relative;
}

.lfd-map {
  width: 100%;
  height: 300rpx;
}

.lfd-map-tip {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 8rpx var(--space-sm);
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.lfd-map-tip text {
  font-size: var(--font-xs);
  color: #FFFFFF;
}

/* 卡片小标题 */
.lfd-card__section-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: var(--space-sm);
}

/* 图片网格 */
.lfd-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

.lfd-grid__img {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-md);
  background-color: var(--color-bg-page);
}

/* 描述 */
.lfd-card__desc {
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* 发布人 */
.lfd-publisher {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.lfd-publisher__avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background-color: var(--color-bg-page);
}

.lfd-publisher__info {
  margin-left: var(--space-md);
  display: flex;
  flex-direction: column;
}

.lfd-publisher__name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text-primary);
}

.lfd-publisher__time {
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--color-text-placeholder);
}

/* 底部留白 */
.lfd-bottom-space {
  height: 160rpx;
}

/* 底部操作按钮 */
.lfd-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: var(--space-sm) var(--space-md);
  background-color: var(--color-bg-card);
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 99;
}

.lfd-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-md);
  font-weight: 600;
  border-radius: var(--radius-full);
  margin: 0 var(--space-xs);
}

.lfd-btn--primary {
  color: #FFFFFF;
  background-color: var(--color-primary);
}

.lfd-btn--secondary {
  color: var(--color-primary);
  background-color: var(--color-bg-card);
  border: 2rpx solid var(--color-primary);
}

.lfd-btn--full {
  flex: 1;
}

.lfd-btn--hover {
  opacity: 0.85;
  transform: scale(0.98);
}
