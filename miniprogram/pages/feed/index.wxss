/* pages/feed/index.wxss */
/* 首页 - 社区信息流（改版）样式 */
/* 搜索栏 + Banner 轮播 + 功能宫格 + 排序 Tab + 帖子列表 */

/* ===== 页面容器：flex 纵向占满 ===== */
.feed-page {
  display: flex;
  flex-direction: column;
  height: 100%;
  background-color: var(--color-bg-page);
}

/* ===== 滚动区：flex:1 占剩余空间 ===== */
.feed-scroll {
  flex: 1;
  padding: 0 var(--space-md);
  box-sizing: border-box;
}

/* ===== 1. 搜索栏（pill 形，浅灰底色，贴近参考图） ===== */
.feed-search {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: var(--space-sm);
  padding: var(--space-sm) var(--space-md);
  background-color: #F0F2F5;
  border-radius: var(--radius-full);
}

.feed-search--hover {
  opacity: 0.7;
}

.feed-search__icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.5;
}

.feed-search__placeholder {
  margin-left: var(--space-sm);
  font-size: var(--font-sm);
  color: var(--color-text-placeholder);
}

/* ===== 2. Banner 轮播（高度 320rpx，约占首屏 20%） ===== */
.feed-banner {
  margin-top: var(--space-md);
  height: 320rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.feed-banner__slide {
  width: 100%;
  height: 100%;
}

.feed-banner__image {
  width: 100%;
  height: 100%;
}

/* ===== 3. 功能宫格（可折叠卡片：常驻高频行 + 额外功能行 + 折叠按钮） ===== */
.feed-grid {
  margin-top: var(--space-md);
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-sm) 0 0;
  overflow: hidden;
}

/* 宫格行：横向排列，每行 4 个 */
.feed-grid__row {
  display: flex;
  flex-direction: row;
}

/* 额外功能行：通过 max-height + opacity 实现折叠/展开动画 */
/* max-height 取略大于单行实际高度（约 148rpx）的值，确保不裁剪内容 */
.feed-grid__row--extra {
  max-height: 200rpx;
  overflow: hidden;
  opacity: 1;
  transition: max-height 0.3s ease, opacity 0.25s ease;
}

/* 折叠态：高度归零 + 淡出 */
.feed-grid__row--extra.is-collapsed {
  max-height: 0;
  opacity: 0;
}

.feed-grid__item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-xs) 0;
  box-sizing: border-box;
}

.feed-grid__item--hover {
  opacity: 0.7;
  transform: scale(0.95);
}

/* 图标容器：圆角方形 96rpx，彩色 10% 透明度背景（贴近参考图） */
.feed-grid__icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feed-grid__icon {
  width: 80rpx;
  height: 80rpx;
}

.feed-grid__name {
  margin-top: var(--space-xs);
  font-size: var(--font-xs);
  color: var(--color-text-primary);
}

/* 折叠 / 展开切换按钮 */
.feed-grid__toggle {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: var(--space-xs) 0 var(--space-sm);
}

.feed-grid__toggle--hover {
  opacity: 0.6;
}

.feed-grid__toggle-text {
  font-size: var(--font-xs);
  color: var(--color-text-placeholder);
  margin-right: var(--space-xs);
}

/* CSS 绘制箭头（chevron）：折叠时朝下，展开时朝上 */
.feed-grid__chevron {
  width: 16rpx;
  height: 16rpx;
  border-right: 3rpx solid var(--color-text-placeholder);
  border-bottom: 3rpx solid var(--color-text-placeholder);
  transform: rotate(45deg);
  transition: transform 0.3s ease;
}

.feed-grid__chevron--up {
  transform: rotate(-135deg);
}

/* ===== 4. 排序 Tab 容器 ===== */
/* 上圆下直：上方两角圆角与宫格风格一致，下方两角直角与帖子列表无缝拼接 */
.feed-tabs-bar {
  margin-top: var(--space-sm);
  margin-bottom: 0;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  overflow: hidden;
}

/* ===== 板块筛选指示条 ===== */
.feed-section-chip {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: var(--space-sm);
  padding: var(--space-xs) var(--space-md);
  background-color: var(--color-primary-10);
  border-radius: var(--radius-full);
}

.feed-section-chip__text {
  font-size: var(--font-sm);
  color: var(--color-primary);
}

.feed-section-chip__close {
  margin-left: var(--space-xs);
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 按压反馈 */
.feed-section-chip__close--hover {
  opacity: 0.5;
}

.feed-section-chip__close-icon {
  width: 24rpx;
  height: 24rpx;
}

/* ===== 帖子列表底部 ===== */
.feed-end {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-lg) 0;
}

.feed-end__text {
  font-size: var(--font-sm);
  color: var(--color-text-placeholder);
}

/* ===== 封禁用户提示 ===== */
.feed-banned {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.feed-banned__text {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-danger);
  margin-bottom: 16rpx;
}

.feed-banned__sub {
  font-size: var(--font-sm);
  color: var(--color-text-placeholder);
}

/* 底部留白 */
.feed-bottom-space {
  height: var(--space-xl);
}

/* ===== 导航栏左上角：定位学校入口 ===== */
/* 该节点是 navigation-bar 的 left 插槽内容，样式归属本页（插槽内容作用域在页面侧）。
   插槽容器 __left 已由组件内联固定宽度（≈95px）且 align-items:flex-start，
   故这里用 height:100% + 自身 align-items:center 做垂直居中，宽度严格控制在「图标+4字+箭头」以内。 */
.nav-school {
  flex: none;               /* 不被插槽容器压缩，避免文案换行 */
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 100%;
  white-space: nowrap;
}

.nav-school--hover {
  opacity: 0.6;
}

.nav-school__icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 6rpx;
}

.nav-school__name {
  font-size: var(--font-sm);
  font-weight: 500;
  line-height: 1;
  color: var(--color-text-primary);
}

/* 下拉箭头：CSS 绘制（与宫格折叠箭头同款做法），避免额外图标资源 */
.nav-school__chevron {
  width: 12rpx;
  height: 12rpx;
  margin-left: 6rpx;
  margin-top: -6rpx;
  border-right: 2rpx solid var(--color-text-secondary);
  border-bottom: 2rpx solid var(--color-text-secondary);
  transform: rotate(45deg);
}

/* ===== 学校选择弹窗 ===== */
/* 居中卡片而非底部抽屉：自定义 TabBar 固定在底部（z-index 999），抽屉会与其叠加，
   居中卡片视觉更干净，且不受 TabBar 高度变化影响 */
.school-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: var(--color-bg-mask);
}

.school-panel {
  width: 592rpx;
  padding: var(--space-lg) var(--space-md) var(--space-md);
  box-sizing: border-box;
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
}

.school-panel__head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
}

.school-panel__titles {
  display: flex;
  flex-direction: column;
}

.school-panel__title {
  font-size: var(--font-lg);
  font-weight: 700;
  line-height: 1.3;
  color: var(--color-text-primary);
}

.school-panel__sub {
  margin-top: var(--space-xs);
  font-size: var(--font-sm);
  line-height: 1.4;
  color: var(--color-text-secondary);
}

.school-panel__close {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.school-panel__close--hover {
  opacity: 0.6;
}

.school-panel__close-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.45;
}

/* 名单滚动区：条目少时自适应，超过 520rpx 才出现滚动 */
.school-panel__list {
  max-height: 520rpx;
  margin-top: var(--space-md);
}

/* 条目序列：用 gap 控制间距（Skyline 下不依赖兄弟选择器） */
.school-panel__items {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.school-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md);
  border-radius: var(--radius-md);
  background-color: var(--color-bg-page);
}

.school-item--hover {
  opacity: 0.7;
}

/* 当前选中项：主色 10% 底 + 主色边框，与全局选中态语言一致 */
.school-item.is-active {
  background-color: var(--color-primary-10);
  border: 2rpx solid var(--color-primary);
}

.school-item__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.school-item__top {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.school-item__name {
  flex: 1;
  min-width: 0;
  font-size: var(--font-md);
  line-height: 1.4;
  color: var(--color-text-primary);
}

.school-item__tag {
  flex: none;
  margin-left: var(--space-sm);
  padding: 0 10rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  border-radius: var(--radius-sm);
  background-color: var(--color-primary);
  color: #FFFFFF;
  font-size: var(--font-xs);
  line-height: 1;
}

.school-item__city {
  margin-top: 4rpx;
  font-size: var(--font-xs);
  line-height: 1.4;
  color: var(--color-text-placeholder);
}

.school-item__check {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-left: var(--space-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: var(--color-primary);
}

/* 对勾：两条边框旋转绘制（与登录页同意勾选同款做法） */
.school-item__check-tick {
  width: 12rpx;
  height: 20rpx;
  margin-top: -4rpx;
  border-right: 3rpx solid #FFFFFF;
  border-bottom: 3rpx solid #FFFFFF;
  transform: rotate(45deg);
}

.school-panel__foot {
  margin-top: var(--space-md);
  font-size: var(--font-xs);
  line-height: 1.4;
  color: var(--color-text-placeholder);
  text-align: center;
}
