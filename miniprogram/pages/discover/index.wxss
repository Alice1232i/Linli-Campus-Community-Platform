/* pages/discover/index.wxss */
/* 发现页 - 板块导航 + 社区热度 + 跨板块内容聚合 */
/* 全量使用设计 token（配色 / 圆角 / 字号 / 间距），板块色复用 SECTION_META 色板，与首页信息流风格统一 */

/* ===== 页面容器：flex 纵向占满 ===== */
.discover-page {
  display: flex;
  flex-direction: column;
  height: 100%;
  background-color: var(--color-bg-page);
}

/* ===== 滚动区：flex:1 占剩余空间，左右统一内边距 ===== */
.discover-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 var(--space-md);
  box-sizing: border-box;
}

/* ===== 1. 页头 ===== */
.discover-header {
  padding: var(--space-md) 0 var(--space-sm);
}

.discover-header__title {
  display: block;
  font-size: var(--font-xxl);
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.3;
}

.discover-header__sub {
  display: block;
  margin-top: var(--space-xs);
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

/* ===== 2. 横向滚动板块标签栏 ===== */
/* 左右负边距（-24rpx = 滚动区左右内边距）使标签可滑动到屏幕边缘 */
.tag-bar {
  margin-left: -24rpx;
  margin-right: -24rpx;
  white-space: nowrap;
}

.tag-bar__inner {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  padding: var(--space-xs) var(--space-md);
  gap: var(--space-sm);
}

/* 标签胶囊：默认「板块色浅底 + 板块色文字」，选中「板块色实心 + 白字」高亮 */
.tag-chip {
  flex-shrink: 0;
  padding: var(--space-xs) var(--space-md);
  border-radius: var(--radius-full);
  transition: background-color 0.2s ease, color 0.2s ease;
}

.tag-chip--hover {
  opacity: 0.75;
}

.tag-chip__text {
  font-size: var(--font-sm);
  font-weight: 500;
  line-height: 1.4;
}

.tag-chip--active .tag-chip__text {
  font-weight: 600;
}

/* ===== 通用卡片（扁平白底，与首页卡片风格一致，无阴影） ===== */
.discover-card {
  margin-top: var(--space-lg);
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-md);
}

.discover-card__head {
  display: flex;
  flex-direction: column;
}

.discover-card__title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text-primary);
}

.discover-card__note {
  margin-top: 4rpx;
  font-size: var(--font-xs);
  color: var(--color-text-placeholder);
}

/* ===== 加载中 / 空状态 ===== */
.discover-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-xl) 0;
}

.discover-state__text {
  font-size: var(--font-sm);
  color: var(--color-text-placeholder);
}

/* ===== 3. 板块热度榜单 ===== */
.hot-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: var(--space-sm) 0;
  border-bottom: 2rpx solid var(--color-divider);
}

.hot-item--last {
  border-bottom: none;
}

.hot-item--hover {
  opacity: 0.7;
}

/* 排名序号 */
.hot-item__rank {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  margin-right: var(--space-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hot-item__rank-num {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text-placeholder);
}

/* 前三名奖牌色：金 / 银 / 铜 */
.hot-item__rank--1 .hot-item__rank-num {
  color: var(--color-warning);
}

.hot-item__rank--2 .hot-item__rank-num {
  color: #9CA3AF;
}

.hot-item__rank--3 .hot-item__rank-num {
  color: #D85A30;
}

.hot-item__main {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

/* 板块标签 + 数据统计行 */
.hot-item__row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.hot-item__tag {
  flex-shrink: 0;
  padding: 2rpx 14rpx;
  font-size: var(--font-sm);
  font-weight: 500;
  border-radius: var(--radius-sm);
  line-height: 1.6;
}

.hot-item__stats {
  margin-left: var(--space-sm);
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 最新帖子动态行 */
.hot-item__latest {
  margin-top: 8rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.hot-item__latest-label {
  flex-shrink: 0;
  margin-right: 8rpx;
  padding: 0 8rpx;
  font-size: var(--font-xs);
  color: var(--color-primary);
  background-color: var(--color-primary-10);
  border-radius: var(--radius-sm);
  line-height: 1.6;
}

.hot-item__latest-text {
  flex: 1;
  min-width: 0;
  font-size: var(--font-xs);
  color: var(--color-text-placeholder);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hot-item__latest-time {
  flex-shrink: 0;
  margin-left: 8rpx;
  font-size: var(--font-xs);
  color: var(--color-text-time);
}

/* ===== 4. 精选内容 ===== */
/* 板块分组标题（板块标签即该组的板块标识） */
.feat-group__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-top: var(--space-sm);
}

.feat-group__tag {
  padding: 2rpx 14rpx;
  font-size: var(--font-sm);
  font-weight: 500;
  border-radius: var(--radius-sm);
  line-height: 1.6;
}

.feat-group__hint {
  margin-left: var(--space-sm);
  font-size: var(--font-xs);
  color: var(--color-text-placeholder);
}

/* 精选帖子行 */
.feat-post {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: var(--space-sm) 0;
  border-bottom: 2rpx solid var(--color-divider);
}

.feat-post--last {
  border-bottom: none;
}

.feat-post--hover {
  opacity: 0.7;
}

.feat-post__avatar {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
  border-radius: 50%;
  background-color: var(--color-bg-page);
}

.feat-post__body {
  flex: 1;
  min-width: 0;
  margin-left: var(--space-sm);
  overflow: hidden;
}

.feat-post__head {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.feat-post__name {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-text-primary);
  max-width: 240rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.feat-post__time {
  flex-shrink: 0;
  margin-left: var(--space-xs);
  font-size: var(--font-xs);
  color: var(--color-text-time);
}

.feat-post__excerpt {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.feat-post__thumb {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
  margin-left: var(--space-sm);
  border-radius: var(--radius-sm);
}

/* ===== 底部留白：为固定定位的自定义 TabBar 让位 ===== */
.discover-bottom-space {
  height: 160rpx;
}
