/**
 * app.wxss
 * 全局样式入口
 * 引入设计 token、全局重置、通用混入，并设置 page 基础样式
 */
@import "styles/variables.wxss";
@import "styles/reset.wxss";
@import "styles/mixins.wxss";

/* page 基础样式（变量已在 variables.wxss 的 page 选择器中声明） */
/* Skyline 不支持 vh 单位：统一用 height:100% + flex 链约束页面高度 */
page {
  width: 100%;
  height: 100%;
  min-height: 100%;
  background-color: var(--color-bg-page);
  color: var(--color-text-primary);
  font-size: var(--font-md);
  line-height: 1.5;
}
